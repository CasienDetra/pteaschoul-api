# --- database (shared by docker-compose and the app) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin2026
POSTGRES_DB=db_room
DATABASE_URL=postgresql+psycopg://postgres:admin2026@localhost:5432/db_room

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_EMAIL=admin@gmail.com
PGADMIN_PASSWORD=admin2026

# --- auth ---
# generate a real one:  openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- billing knobs: utility tariffs, tune to your actual bill ---
ELECTRICITY_RATE=0.25
WATER_RATE=0.60
# bills are priced and settled in BASE_CURRENCY; EXCHANGE_RATES is what else a tenant may
# hand over, as units per 1 BASE_CURRENCY (JSON) — the house rate, not a live feed
BASE_CURRENCY=USD
EXCHANGE_RATES={"KHR": 4100}
INVOICE_DUE_DAY=10
LOG_LEVEL=INFO
